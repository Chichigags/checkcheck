SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_ANON_KEY

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=YOUR_RANDOM_WEBHOOK_SECRET
CRON_SECRET=YOUR_RANDOM_CRON_SECRET

OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
# Optional — defaults to moonshotai/kimi-k2.6 (kimi-k2.5 retired Aug 2026)
OPENROUTER_MODEL=moonshotai/kimi-k2.6

# V5: news enables the new Bot and dispatcher; bazi restores legacy behavior.
# Defaults to bazi when unset, so deployment/configuration is explicit.
BOT_MODE=news
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
# Required: choose an available OpenRouter model supporting JSON object output.
NEWS_MODEL=YOUR_OPENROUTER_MODEL_ID
# Optional trusted publishers (comma-separated domains); defaults are in production.ts.
# NEWS_SOURCE_DOMAINS=reuters.com,apnews.com,bbc.com,channelnewsasia.com,scmp.com,nikkei.com,techcrunch.com,arstechnica.com,nature.com,science.org
