SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_ANON_KEY

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=YOUR_RANDOM_WEBHOOK_SECRET
CRON_SECRET=YOUR_RANDOM_CRON_SECRET

OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
# Optional — defaults to moonshotai/kimi-k2.6 (kimi-k2.5 retired Aug 2026)
OPENROUTER_MODEL=moonshotai/kimi-k2.6

# V5: news enables the new Bot and dispatcher; bazi restores legacy behavior.
# Defaults to bazi when unset, so deployment/configuration is explicit.
BOT_MODE=news
# Secret shared only by the scheduled assistant and server; not a model API key.
NEWS_INGEST_SECRET=YOUR_RANDOM_NEWS_UPLOAD_SECRET
# Local assistant submission script only; not needed by the Vercel server.
CHECKCHECK_BASE_URL=https://YOUR_DEPLOYMENT.vercel.app
